# CT 123, one card, the configuration the test record starts from. The sweep rewrites the
# settings per cell and restores this file when it ends.
# Install: VMID=123 ./install.sh. Installed as /etc/llamacpp-glm53f.env.
# systemd EnvironmentFile comments must occupy their own lines.

# Release build; glm5-next and its MTP need #27773 and #29928, both in b11505.
LLAMACPP_DIR="/opt/llamacpp/llama-b11505"

# First shard, metadata only; llama.cpp discovers the other five.
MODEL_PATH=/models/hf/glm-5.3-flash/GLM-5.3-Flash-UD-Q4_K_XL-00001-of-00006.gguf
MODEL_ALIAS=glm-5.3-flash
MODEL_MMPROJ=/models/hf/glm-5.3-flash/mmproj-F16.gguf
MODEL_SERVER_BIND=0.0.0.0
MODEL_SERVER_PORT=1234
MODEL_GPU_LAYERS="99"

# Routed experts of the first N GGUF blocks in host RAM. 46 covers blocks 0-45, the MTP
# block included: every expert in RAM, which fits one card with room to spare.
MODEL_CPU_MOE="46"

# More --override-tensor rules, comma-separated. Block 45's experts alone in RAM:
# blk\.45\.ffn_(up|gate|down)_exps=CPU
MODEL_OT_OVERRIDE=""

# Explicit context; automatic fitting can spill KV to GTT on RADV.
MODEL_CONTEXT_LENGTH="65536"
MODEL_PARALLEL="1"
MODEL_THREADS="16"

# Startup guard: the number of V620s llama-server must see.
MODEL_EXPECTED_GPUS="1"

# Vulkan device indices to expose (GGML_VK_VISIBLE_DEVICES), as vulkaninfo numbers them.
# Empty exposes every card. Lets a one-card cell run in a container holding both cards.
MODEL_VK_VISIBLE_DEVICES=""

# No tensor split on one card.
MODEL_TENSOR_SPLIT=""

# auto (mmap) when empty; dio pins the CPU-resident experts in host memory (GTT).
MODEL_LOAD_MODE=""

# Reasoning budget in tokens; empty leaves llama.cpp's default. --reasoning off alone does not
# stop this model thinking: bare chat and reasoning_effort none/max returned empty content.
# 0 ends thinking at once and answers cleanly at every effort value
# (runs/2026-10-10-configurations.md, stage 1).
MODEL_REASONING_BUDGET="0"

EXTRA_ARGS="--device Vulkan0"

MODEL_BATCH_SIZE="4096"
MODEL_UBATCH_SIZE="1024"

# f16 until the test record's screen decides on q8_0.
MODEL_KV_TYPE="f16"

# Saves VRAM at the cost of image-encoding latency.
MODEL_MMPROJ_ON_CPU="true"
