# CT 123, one card: stages 1-4's winners from runs/2026-10-13-long-tasks.md (#106), at one
# 64k slot, for that record's stage 5 bench.
# Install: VMID=123 ENV_FILE=glm53f-long.env ./install.sh, after
# TEST_CPUSET=0-47 ./ct123-test-host.sh one-card: the CPU mask below assumes CPUs 0-31.
# Installed as /etc/llamacpp-glm53f.env. systemd EnvironmentFile comments must occupy their
# own lines.

# Release build; b11583 replaced b11505 in stage 0 (images work under MTP).
LLAMACPP_DIR="/opt/llamacpp/llama-b11583"

# Batches under 512 tokens run the CPU-resident experts on the CPU instead of over PCIe
# on the card: short agent turns on a deep context 4.4 -> 2.4 s (stage 1).
GGML_OP_OFFLOAD_MIN_BATCH="512"

# First shard, metadata only; llama.cpp discovers the other five.
MODEL_PATH=/models/hf/glm-5.3-flash/GLM-5.3-Flash-UD-Q4_K_XL-00001-of-00006.gguf
MODEL_ALIAS=glm-5.3-flash
MODEL_MMPROJ=/models/hf/glm-5.3-flash/mmproj-F16.gguf
MODEL_SERVER_BIND=0.0.0.0
MODEL_SERVER_PORT=1234
MODEL_GPU_LAYERS="99"

# The MTP block's (45) experts on the card, the other blocks' in host RAM. It fits only at
# micro-batch 2048: at 4096 a compute-buffer swap left 54 MiB and spilled to GTT (stage 2).
MODEL_CPU_MOE="45"
MODEL_OT_OVERRIDE=""

# 64k in one slot. The batch's reload helper rewrites both per item.
MODEL_CONTEXT_LENGTH="65536"
MODEL_PARALLEL="1"
MODEL_THREADS="32"

# Startup guard: the number of V620s llama-server must see.
MODEL_EXPECTED_GPUS="1"
MODEL_VK_VISIBLE_DEVICES=""
MODEL_TENSOR_SPLIT=""

# dio pins the CPU-resident experts in host memory (GTT): 2.8 times auto's prefill (stage 3).
MODEL_LOAD_MODE="dio"

# --reasoning off alone does not stop this model thinking; budget 0 answers cleanly at every
# effort value (stage 1).
MODEL_REASONING_BUDGET="0"

# MTP from GGUF block 45, no draft file: n-max 2 at p-min 0.2 (stage 3; p-min 0-0.5 were
# within 0.5% of each other). 32 threads pinned one per physical core, CPUs 0-31 (stage 4:
# decode +5%); the batch and draft threads default to the same mask.
EXTRA_ARGS="--device Vulkan0 --spec-type draft-mtp --spec-draft-n-max 2 --spec-draft-p-min 0.2 --cpu-mask 0xffffffff --cpu-strict 1"

# Micro-batch 2048 costs about 21% of cold prefill against 4096 (stage 2).
MODEL_BATCH_SIZE="4096"
MODEL_UBATCH_SIZE="2048"
MODEL_KV_TYPE="f16"

# Saves VRAM at the cost of image-encoding latency.
MODEL_MMPROJ_ON_CPU="true"
