# Stage 2 of runs/2026-10-13-long-tasks.md (micro-batch and placement), the FIT pass: one pass,
# CT 123 holding 0000:83:00.0 only, DEPTHS=0,8000,48000 with CONTEXT_FILE (exact tokens of the
# pinned corpus), PROBE_CHAT=true, every prompt class, TURNS with TURN_DEPTH=30000, a residency
# sampler and the VRAM release trace on the card.
#
# Every cell: b11583 and GGML_OP_OFFLOAD_MIN_BATCH=512 (stages 0 and 1), MTP at n-max 2, dio,
# 32 threads, f16 KV, one 64k slot. A cell fits by the plan's four rules: nothing outside
# VRAM, no failed VRAM allocation in the trace, at least 1,024 MiB free including swaps and
# at least 3,072 MiB outside swaps. If -ncmoe 45 fits at neither micro-batch, a second fit
# pass tries it at 1024.
#
# n46-ub4096 is the control (stage 1's winner). -ncmoe 45 puts block 45's experts, the MTP
# block's, on the card. The batch stays 4096 in every cell; only the micro-batch changes.
n46-ub4096  MODE=1gpu NCMOE=46 KV=f16 CTX=65536 UBATCH=4096 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 2' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512' TURNS=true
n45-ub4096  MODE=1gpu NCMOE=45 KV=f16 CTX=65536 UBATCH=4096 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 2' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512' TURNS=true
n46-ub2048  MODE=1gpu NCMOE=46 KV=f16 CTX=65536 UBATCH=2048 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 2' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512' TURNS=true
n45-ub2048  MODE=1gpu NCMOE=45 KV=f16 CTX=65536 UBATCH=2048 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 2' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512' TURNS=true
