# Stage 3 of runs/2026-10-13-long-tasks.md (draft length and confidence), the SCREEN: one
# pass, CT 123 holding 0000:83:00.0 only, DEPTHS=8000,48000 with CONTEXT_FILE (exact tokens of
# the pinned corpus), PROBE_CHAT=true, PROBE_ARGS="--n-predict 640 --cache", every prompt
# class, a residency sampler and the VRAM release trace on the card.
#
# Every cell runs on stage 2's winner, n45-ub2048: b11583, GGML_OP_OFFLOAD_MIN_BATCH=512,
# -ncmoe 45, micro-batch 2048, dio, 32 threads, f16 KV, one 64k slot, batch 4096. n2-p0
# (n-max 2, p-min 0: b11583's default) is the speed control; nospec, the same placement
# without speculation, is the correctness control.
n2-p0    MODE=1gpu NCMOE=45 KV=f16 CTX=65536 UBATCH=2048 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 2 --spec-draft-p-min 0' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512'
n1-p0    MODE=1gpu NCMOE=45 KV=f16 CTX=65536 UBATCH=2048 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 1 --spec-draft-p-min 0' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512'
n1-p02   MODE=1gpu NCMOE=45 KV=f16 CTX=65536 UBATCH=2048 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 1 --spec-draft-p-min 0.2' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512'
n1-p03   MODE=1gpu NCMOE=45 KV=f16 CTX=65536 UBATCH=2048 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 1 --spec-draft-p-min 0.3' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512'
n1-p05   MODE=1gpu NCMOE=45 KV=f16 CTX=65536 UBATCH=2048 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 1 --spec-draft-p-min 0.5' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512'
n2-p02   MODE=1gpu NCMOE=45 KV=f16 CTX=65536 UBATCH=2048 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 2 --spec-draft-p-min 0.2' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512'
n2-p03   MODE=1gpu NCMOE=45 KV=f16 CTX=65536 UBATCH=2048 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 2 --spec-draft-p-min 0.3' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512'
n2-p05   MODE=1gpu NCMOE=45 KV=f16 CTX=65536 UBATCH=2048 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 2 --spec-draft-p-min 0.5' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512'
n3-p0    MODE=1gpu NCMOE=45 KV=f16 CTX=65536 UBATCH=2048 PARALLEL=1 LOAD_MODE=dio THREADS=32 EXTRA='--spec-type draft-mtp --spec-draft-n-max 3 --spec-draft-p-min 0' ENV='LLAMACPP_DIR=/opt/llamacpp/llama-b11583 GGML_OP_OFFLOAD_MIN_BATCH=512'
