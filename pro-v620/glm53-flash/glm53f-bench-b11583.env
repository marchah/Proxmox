# CT 123, one card: glm53f-bench.env (the usage batch's configuration) on b11583, the
# control for stage 5 of runs/2026-10-13-long-tasks.md. Only LLAMACPP_DIR differs.
# Install: VMID=123 ENV_FILE=glm53f-bench-b11583.env ./install.sh, after ./ct123-test-host.sh one-card.
# Installed as /etc/llamacpp-glm53f.env. systemd EnvironmentFile comments must occupy their
# own lines.

# Release build; b11583 replaced b11505 in that record's stage 0.
LLAMACPP_DIR="/opt/llamacpp/llama-b11583"

# First shard, metadata only; llama.cpp discovers the other five.
MODEL_PATH=/models/hf/glm-5.3-flash/GLM-5.3-Flash-UD-Q4_K_XL-00001-of-00006.gguf
MODEL_ALIAS=glm-5.3-flash
MODEL_MMPROJ=/models/hf/glm-5.3-flash/mmproj-F16.gguf
MODEL_SERVER_BIND=0.0.0.0
MODEL_SERVER_PORT=1234
MODEL_GPU_LAYERS="99"

# Every routed expert in host RAM, the MTP block's included. With MTP at n-max 8,
# micro-batch 4096 and two slots, block 45's experts had no fit on the card (stage 7a);
# a shorter draft or one 64k slot was not tested.
MODEL_CPU_MOE="46"
MODEL_OT_OVERRIDE=""

# 64k in one slot. The batch's reload helper rewrites both per item.
MODEL_CONTEXT_LENGTH="65536"
MODEL_PARALLEL="1"
MODEL_THREADS="32"

# Startup guard: the number of V620s llama-server must see.
MODEL_EXPECTED_GPUS="1"
MODEL_VK_VISIBLE_DEVICES=""
MODEL_TENSOR_SPLIT=""

# dio pins the CPU-resident experts in host memory (GTT): 2.8 times auto's prefill (stage 3).
MODEL_LOAD_MODE="dio"

# --reasoning off alone does not stop this model thinking; budget 0 answers cleanly at every
# effort value (stage 1).
MODEL_REASONING_BUDGET="0"

# MTP from GGUF block 45, no draft file. n-max 2 decoded fastest at one and two streams
# (stages 7b-7c). With MTP on Vulkan, image requests fail (llama.cpp #30204).
EXTRA_ARGS="--device Vulkan0 --spec-type draft-mtp --spec-draft-n-max 2"

MODEL_BATCH_SIZE="4096"
MODEL_UBATCH_SIZE="4096"
MODEL_KV_TYPE="f16"

# Saves VRAM at the cost of image-encoding latency.
MODEL_MMPROJ_ON_CPU="true"
