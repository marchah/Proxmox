# CT 123, one-card deployment. Install: VMID=123 ENV_FILE=qwen38fn-gpu2.env ./install.sh
# Installed as /etc/llamacpp-qwen38fn.env. Measurements are in README.md.
# systemd EnvironmentFile comments must occupy their own lines.

# Local baseline build; differs from the release tree in qwen38fn.env.
LLAMACPP_DIR="/opt/llamacpp/b11018-baseline"

# First shard; llama.cpp discovers the remaining three.
MODEL_PATH=/models/hf/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf
MODEL_ALIAS=qwen3.8-flash-next
MODEL_MMPROJ=/models/hf/qwen3.8-flash-next/mmproj-F16.gguf
MODEL_SERVER_BIND=0.0.0.0
MODEL_SERVER_PORT=1234
MODEL_GPU_LAYERS="99"

# PLE lookup table in host RAM.
MODEL_OT_OVERRIDE="per_layer_token_embd=CPU"

# Lowest validated one-card placement; each extra CPU layer frees ~1.5 GiB.
MODEL_CPU_MOE="34"

# Explicit context; automatic fitting can spill KV to GTT on RADV.
MODEL_CONTEXT_LENGTH="65536"
MODEL_PARALLEL="1"
MODEL_THREADS="16"

# Startup guard requires one device.
MODEL_EXPECTED_GPUS="1"

# No tensor split on one card.
MODEL_TENSOR_SPLIT=""

# Empty uses auto (mmap).
MODEL_LOAD_MODE=""

# Vulkan0 is the only GPU passed through to CT 123.
EXTRA_ARGS="--device Vulkan0"

# Load-checked on CT 123; do not copy this batch to the two-card config.
MODEL_BATCH_SIZE="4096"
MODEL_UBATCH_SIZE="1024"

# Keep reasoning disabled with q8_0; use f16 before enabling reasoning.
MODEL_KV_TYPE="q8_0"

# Saves VRAM at the cost of image-encoding latency.
MODEL_MMPROJ_ON_CPU="true"
