# Cells for runs/2026-10-08-threads-concurrency.md, run on CT 123 (one V620, 24 cores).
# Threads 8, 16 and 24 at one, two and four slots; ctx 65536 is shared by the slots.
t8-p1     MODE=1gpu NCMOE=34 THREADS=8  PARALLEL=1
t16-p1    MODE=1gpu NCMOE=34 THREADS=16 PARALLEL=1
t24-p1    MODE=1gpu NCMOE=34 THREADS=24 PARALLEL=1
t8-p2     MODE=1gpu NCMOE=34 THREADS=8  PARALLEL=2 STREAMS=2
t16-p2    MODE=1gpu NCMOE=34 THREADS=16 PARALLEL=2 STREAMS=2
t24-p2    MODE=1gpu NCMOE=34 THREADS=24 PARALLEL=2 STREAMS=2
t8-p4     MODE=1gpu NCMOE=34 THREADS=8  PARALLEL=4 STREAMS=4
t16-p4    MODE=1gpu NCMOE=34 THREADS=16 PARALLEL=4 STREAMS=4
t24-p4    MODE=1gpu NCMOE=34 THREADS=24 PARALLEL=4 STREAMS=4
