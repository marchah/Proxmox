# Cells for runs/2026-10-16-strata.md, stage 7, applied over the screen's kept settings, in
# CT 123 holding both cards (use-engine.sh strata-two-card), with PASSES=1. Two arms, alternated:
# one-* on GPU 2 alone, split-* on the layer split with GPU 2 first (stage 2's split21). Each
# arm has a no-draft control; s2..s6 load the MTP draft layer at --spec N --spec-min-p 0.5 (the
# engine needs a window of at least 2). Suffix drafts stay off, so the drafts are MTP's alone.
# If an arm's decode still rises at s6, the record adds s7, s8, ... for that arm. The best length
# of each arm and that arm's control then get three passes (2026-10-16-strata-7-confirm.cells).
# STRATA_MMQ_KQ=1 is the screen's kept setting, given here rather than in the env file: the env
# file is also the served configuration, and that switch changes numerics (the owner's call).
one-ctl    MODEL_MTP= MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0 STRATA_MMQ_KQ=1
split-ctl  MODEL_MTP= MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0,0000:03:00.0 MODEL_LAYER_SPLIT=auto STRATA_MMQ_KQ=1
one-s2     MODEL_SPEC=2 MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0 STRATA_MMQ_KQ=1
split-s2   MODEL_SPEC=2 MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0,0000:03:00.0 MODEL_LAYER_SPLIT=auto STRATA_MMQ_KQ=1
one-s3     MODEL_SPEC=3 MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0 STRATA_MMQ_KQ=1
split-s3   MODEL_SPEC=3 MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0,0000:03:00.0 MODEL_LAYER_SPLIT=auto STRATA_MMQ_KQ=1
one-s4     MODEL_SPEC=4 MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0 STRATA_MMQ_KQ=1
split-s4   MODEL_SPEC=4 MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0,0000:03:00.0 MODEL_LAYER_SPLIT=auto STRATA_MMQ_KQ=1
one-s5     MODEL_SPEC=5 MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0 STRATA_MMQ_KQ=1
split-s5   MODEL_SPEC=5 MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0,0000:03:00.0 MODEL_LAYER_SPLIT=auto STRATA_MMQ_KQ=1
one-s6     MODEL_SPEC=6 MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0 STRATA_MMQ_KQ=1
split-s6   MODEL_SPEC=6 MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0,0000:03:00.0 MODEL_LAYER_SPLIT=auto STRATA_MMQ_KQ=1
