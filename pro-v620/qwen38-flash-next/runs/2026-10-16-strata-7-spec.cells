# Cells for runs/2026-10-16-strata.md, stage 7, applied over stage 6's kept settings.
# ctl has no drafts; suffix has only the suffix (prompt-lookup) drafts; s2..s6 add the MTP draft
# layer at --spec-min-p 0.5 (the engine needs a window of at least 2, so the scan starts there).
# If decode still rises at s6, the record adds s7, s8, ... until it
# has clearly fallen past its peak; then it adds the best length and its neighbours at
# --spec-min-p 0.3 and 0.7, and the best one at two streams (with --batch-mtp if stage 6
# kept two slots).
ctl        MODEL_MTP= MODEL_EXTRA_ARGS='--suffix-draft 0'
suffix     MODEL_MTP= MODEL_EXTRA_ARGS=
s2         MODEL_SPEC=2 MODEL_SPEC_MIN_P=0.5 MODEL_EXTRA_ARGS=
s3         MODEL_SPEC=3 MODEL_SPEC_MIN_P=0.5 MODEL_EXTRA_ARGS=
s4         MODEL_SPEC=4 MODEL_SPEC_MIN_P=0.5 MODEL_EXTRA_ARGS=
s5         MODEL_SPEC=5 MODEL_SPEC_MIN_P=0.5 MODEL_EXTRA_ARGS=
s6         MODEL_SPEC=6 MODEL_SPEC_MIN_P=0.5 MODEL_EXTRA_ARGS=
