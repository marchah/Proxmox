# Cells for runs/2026-10-16-strata.md, stage 6, applied over stage 5's kept settings. No drafts.
# p1 and p2 both run two concurrent streams; with one slot the second request waits.
ctl        MODEL_MTP= MODEL_EXTRA_ARGS='--suffix-draft 0'
ctx128k    MODEL_MTP= MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_CONTEXT_LENGTH=131072
p1         MODEL_MTP= MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_PARALLEL=1 STREAMS=2
p2         MODEL_MTP= MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_PARALLEL=2 STREAMS=2
