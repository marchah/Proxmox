# Cells for runs/2026-10-16-strata.md, stage 2, applied over stage 1's kept settings, in CT 123
# holding both cards (../../strata/use-engine.sh strata-two-card). No drafts. Cards are named by
# PCI address: 0000:83:00.0 is GPU 2, the card every one-card cell uses; 0000:03:00.0 is GPU 1.
# split21 and split12 run Strata's layer split with its automatic split point, the first card
# first (the head and the draft layer sit on the last stage); helper runs GPU 2 with GPU 1
# caching experts GPU 2 does not hold.
one       MODEL_MTP= MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0
split21   MODEL_MTP= MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:83:00.0,0000:03:00.0 MODEL_LAYER_SPLIT=auto
split12   MODEL_MTP= MODEL_EXTRA_ARGS='--suffix-draft 0' MODEL_GPUS=0000:03:00.0,0000:83:00.0 MODEL_LAYER_SPLIT=auto
helper    MODEL_MTP= MODEL_EXTRA_ARGS='--suffix-draft 0 --expert-cache-device1 auto --remote-expert-opt' MODEL_GPUS=0000:83:00.0,0000:03:00.0
