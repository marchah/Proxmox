# Cells for the configurations sweep of runs/2026-10-08-utilization.md, run on CT 120 holding
# both V620s.
# Two GPUs: the shipped two-card config, its tensor-split alternative, and a two-card cell
# matched to the one-card production placement and batch.
2gpu-16          MODE=2gpu NCMOE=16
2gpu-16-tensor   MODE=2gpu NCMOE=16 SPLIT_MODE=tensor
2gpu-34          MODE=2gpu NCMOE=34 BATCH=4096 UBATCH=1024
# One GPU: CT 123's production placement, then VRAM handed back.
1gpu-34          MODE=1gpu NCMOE=34
1gpu-40          MODE=1gpu NCMOE=40
# Optimized: one GPU with every expert in RAM, leaving ~23 GB of VRAM for a second model.
1gpu-48          MODE=1gpu NCMOE=48
# CPU only: the whole model in system RAM, --device none.
cpu              MODE=cpu
