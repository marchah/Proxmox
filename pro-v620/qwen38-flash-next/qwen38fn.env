# CT 120, two-card alternative. Install: VMID=120 ./install.sh
# Installed as /etc/llamacpp-qwen38fn.env. Measurements are in README.md.
# systemd EnvironmentFile comments must occupy their own lines.

# Release build; Vulkan qwen4exp requires b11013+. See README verification boundaries.
LLAMACPP_DIR=/opt/llamacpp/llama-b11018

# First shard; llama.cpp discovers the remaining three.
MODEL_PATH=/models/hf/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf
MODEL_ALIAS=qwen3.8-flash-next
MODEL_MMPROJ=/models/hf/qwen3.8-flash-next/mmproj-F16.gguf
MODEL_SERVER_BIND=0.0.0.0
MODEL_SERVER_PORT=1234
MODEL_GPU_LAYERS=99

# PLE lookup table in host RAM.
MODEL_OT_OVERRIDE=per_layer_token_embd=CPU

# Routed experts in the first N of 48 layers run on CPU.
MODEL_CPU_MOE=16

# Explicit context; automatic fitting can spill KV to GTT on RADV.
MODEL_CONTEXT_LENGTH=65536
MODEL_PARALLEL=1

# Retune at the intended concurrency; see README measurements.
MODEL_THREADS=16

# Startup guard requires both devices.
MODEL_EXPECTED_GPUS=2

# Validated split at 1024/256 on the baseline build; retune with batch/context.
MODEL_TENSOR_SPLIT=30,18

# This release-binary/batch pair still needs an end-to-end load check.
MODEL_BATCH_SIZE=1024
MODEL_UBATCH_SIZE=256

# Keep reasoning disabled with q8_0; use f16 before enabling reasoning.
MODEL_KV_TYPE=q8_0

# Saves VRAM at the cost of image-encoding latency.
MODEL_MMPROJ_ON_CPU=true

# Empty uses auto (mmap), the faster measured load mode.
MODEL_LOAD_MODE=

# Extra llama-server flags, word-split by the launcher.
EXTRA_ARGS=
