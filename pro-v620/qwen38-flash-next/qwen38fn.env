# Config for CT 120 serving Qwen3.8-Flash-Next (qwen4exp) across BOTH Radeon Pro V620s.
# Installed to /etc/llamacpp-qwen38fn.env inside CT 120. Read by llamacpp-serve-qwen38fn.
#
# systemd EnvironmentFile= does NOT strip trailing inline comments — keep comments on
# their own lines, never after a VAR=value.

# Pin the build explicitly rather than following /opt/llamacpp/current, so this model and
# the qwen3.6 rollback can sit on different llama.cpp builds. b11018 carries three merged
# qwen4exp follow-ups that b10678 predates (#27880 graph splits, #27941 fixes, #28023
# indexer head slices). b10678 CAN load the arch — see README, the "one build short" claim
# in the KB is wrong — so it is a working rollback target.
LLAMACPP_DIR=/opt/llamacpp/llama-b11018

# First shard only; llama.cpp discovers 00002..00004 itself.
MODEL_PATH=/models/hf/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf
MODEL_ALIAS=qwen3.8-flash-next

# Vision projector. Qwen3.8-Flash-Next is image-text-to-text; without this the server
# answers "image input is not supported" and an agent keeps working regardless — a silent
# failure mode this homelab has already been bitten by. +~1.1 GiB VRAM.
MODEL_MMPROJ=/models/hf/qwen3.8-flash-next/mmproj-F16.gguf

MODEL_SERVER_BIND=0.0.0.0
MODEL_SERVER_PORT=1234

# All non-expert layers on GPU; placement is controlled by MODEL_CPU_MOE below, not here.
MODEL_GPU_LAYERS=99

# 🔴 The PLE n-gram table: ~51B of the 180B checkpoint, ~28.7 GB at Q4. It is a row
# LOOKUP, not a matmul (a handful of rows per token), so it costs almost nothing to keep
# off the GPU and is what makes Q4 reachable at all: 111.3 GB total -> ~82.6 GB GPU-side.
# ⚠️ The tensor is `per_layer_token_embd` (gguf-py constants.py:1478). `ngram_embedding`
# is the SAFETENSORS name and matches nothing in a GGUF — the KB's regex carried it.
MODEL_OT_OVERRIDE=per_layer_token_embd=CPU

# How many of the 48 MoE layers keep their ROUTED EXPERTS in system RAM — the FIRST N,
# per llama.cpp's own wording. This is the VRAM/RAM dial and the subject of
# placement-sweep.sh. ~1.56 GB of Q4 expert weight per layer, so each +1 hands ~1.56 GB
# back to VRAM and moves that layer's expert read onto the memory bus.
#   0  -> needs 82.6 GB of VRAM (does not fit two 32 GB cards)
#   16 -> MEASURED FLOOR for two cards, and the fastest cell: 14.46 t/s / 13.37 at 8k
#   20 -> 13.03; 28 -> ~11.3 and leaves ~20 GB of VRAM free for a second model
#   34 -> fits ONE card (13.01 there, and one card BEATS two at this placement)
#   48 -> all experts in RAM; derived split is 48,0 so it is really single-GPU
# ⚠️ 15 was the old "minimum that fits" and it does NOT fit in the shape measured here —
# 64.2 GiB of demand against 64 GiB. It may fit with q8_0 + projector on CPU (computed
# 1571 MiB/card free); untested, see README.
MODEL_CPU_MOE=16

MODEL_CONTEXT_LENGTH=65536
MODEL_PARALLEL=1

# Physical cores. The host is a 32-core/64-thread EPYC 7532; expert FFN on the CPU is the
# thing being timed, and SMT siblings do not add memory bandwidth.
MODEL_THREADS=32

# ⚠️ Explicit context, never `auto` / `--fit on`: on RADV auto-fit over-commits and puts
# the KV cache silently in GTT — a ~12x decode collapse the loud-guard does NOT catch.

# How many V620s the startup guard insists RADV offers. 2 for the production shape; the
# sweep sets 1 for its ONE_GPU control. A missing card does NOT fail a load on its own —
# llama.cpp would quietly place those layers in host RAM — so this is counted, not
# merely checked for non-zero.
MODEL_EXPECTED_GPUS=2

# Leave EMPTY. Only set to low/medium/xhigh if the contract check shows bare chat
# requests failing; never to "none" or "high", which this template raises on.
# MODEL_REASONING_EFFORT=

# Loading mode: auto (default) | none | mmap | mlock. llama.cpp warns at startup that
# CPU tensor overrides + mmap is slower and suggests `none`. With mmap the PLE table and
# the CPU-side experts are file-backed and can be faulted back from the SATA SSD; `none`
# makes them anonymous memory, which with swap 0 stays put. A sweep axis, not yet decided.
# 🔴 Layer-split proportions, REQUIRED alongside MODEL_CPU_MOE. Without it the default
# even-by-count split overloads the second card, because --n-cpu-moe makes the FIRST N
# layers light and the rest heavy. Measured: 9.3 GiB spilled to GTT and 6.6 tok/s.
# 🔴 CORRECTED 2026-09-18 — and this file shipped the WRONG value. The obvious rule
# `card1 = CPU_MOE + (48 - CPU_MOE)/2` leaves card 1 ~2 layers overcommitted and it spills
# anyway: at CPU_MOE 20 it gives 34,14, which was measured SPILLING (101 MiB in GTT, only
# 823 MiB free) for 12.69 t/s, where the corrected 32,16 fits with 4.0/4.9 GiB free and does
# 13.03. Use `card1 = CPU_MOE + (48 - CPU_MOE)/2 - 2`; at 16 -> 30,18.
# ⚠️ CPU_MOE 48 is exempt and must stay 48,0 (no heavy layers left to rebalance).
MODEL_TENSOR_SPLIT=30,18

# 🔴 The best-measured two-card shape quantises the KV cache and keeps the vision projector
# on the CPU: 59.3 GiB of demand and 14.17/13.45 t/s, against 61.1 GiB and 14.16/13.07 for
# f16 with the projector resident. An earlier revision of the README rejected this on a
# "q8_0 costs ~14% at depth" figure that was later RETRACTED as a GTT-spill artifact — the
# clean pair has q8_0 +2.9% at depth AND 1.6 GiB cheaper, so it wins on both axes.
# ⚠️ q8_0 KV is only safe because this server runs --reasoning off. The coupling is a hard
# XOR on this box: `reasoning off + q8_0` OR `reasoning low/medium + f16`; mixing gives
# silent empty replies. Do not relax --reasoning without reverting this to f16.
# ⚠️ --no-mmproj-offload costs 3-5x on IMAGE ENCODING only (text is unaffected). If vision
# latency matters, clear both keys and accept 1.6 GiB less headroom.
MODEL_KV_TYPE=q8_0
MODEL_MMPROJ_ON_CPU=true

MODEL_LOAD_MODE=

# Appended verbatim to llama-server (word-split). placement-sweep.sh writes --device
# here for its single-GPU control.
EXTRA_ARGS=
