# CT 120 — Qwen3.8-Flash-Next (qwen4exp) across BOTH V620s. Installed to
# /etc/llamacpp-qwen38fn.env; read by llamacpp-serve-qwen38fn.
#
# ⚠️ This is the ALTERNATIVE shape. The model ships on CT 123, one card — see
# qwen38fn-gpu2.env. One card beats two by 21-24% on decode at matched placement; the second
# card buys prefill (+97%), not decode (+11%).
# ⚠️ systemd EnvironmentFile= does NOT strip trailing inline comments — comments go on their
# own lines, never after a VAR=value.
#
# 📖 Every measurement, retraction and correction behind these values lives in README.md.
# Values here carry only what you need to change one safely.

# 🔴 b11013 is a HARD FLOOR: the qwen4exp arch STRING is in b10678, so a grep says
# "supported", but the Vulkan hyper-connection ops only landed in #28988. b10678 cannot
# execute this model on RADV — it is NOT a rollback target. Roll back to b11013 or later.
# ⚠️ Name the TREE, not the container: CT 120 holds both `llama-b11018` (release, GNU 11.4.0,
# sha 4ac7aa75) and `b11018-baseline` (built here, GNU 13.3.0, sha 32687325, byte-identical to
# CT 123's). This file pins the release tree. The README's sweep numbers were measured on the
# baseline tree, so pin the same binary on both sides before A/B'ing.
LLAMACPP_DIR=/opt/llamacpp/llama-b11018

# First shard only; llama.cpp discovers 00002..00004 itself.
MODEL_PATH=/models/hf/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf
MODEL_ALIAS=qwen3.8-flash-next

# Vision projector, +~1.1 GiB VRAM. ⚠️ Without it the server answers "image input is not
# supported" and an agent keeps working regardless — a silent failure mode already hit here.
MODEL_MMPROJ=/models/hf/qwen3.8-flash-next/mmproj-F16.gguf

MODEL_SERVER_BIND=0.0.0.0
MODEL_SERVER_PORT=1234

# All non-expert layers on GPU. Placement is MODEL_CPU_MOE below, not this.
MODEL_GPU_LAYERS=99

# 🔴 The PLE n-gram table (~28.7 GB at Q4) to host RAM. It is a row LOOKUP, not a matmul, so
# it costs almost nothing off-GPU and is what makes Q4 reachable: 111.3 GB -> ~82.6 GB
# GPU-side. ⚠️ The tensor is `per_layer_token_embd`; `ngram_embedding` is the SAFETENSORS
# name and matches nothing in a GGUF.
MODEL_OT_OVERRIDE=per_layer_token_embd=CPU

# The VRAM/RAM dial: routed experts of the FIRST N of 48 MoE layers go to system RAM,
# ~1.56 GB each. Measured ladder (two cards, d0 / 8k):
#   16 -> 14.46 / 13.37, the floor and the fastest    28 -> ~11.3, frees ~20 GB for a guest
#   20 -> 13.03 / 12.06                               34 -> fits ONE card (13.01 there)
#   48 -> all experts in RAM; derived split is 48,0, so it is really single-GPU
# ⚠️ 15 is NOT viable: measured at split 29,19 it spilled (3256 / 89 MiB free — starved by
# maldistribution, not capacity), and its best balanced estimate of 1571 MiB/card fails the
# headroom rule for a new placement. Other splits at 15 are untested and deprioritised.
MODEL_CPU_MOE=16

# ⚠️ Explicit, never `auto` / `--fit on`: on RADV auto-fit over-commits and puts the KV cache
# silently in GTT — a ~12x decode collapse the startup guard does NOT catch.
MODEL_CONTEXT_LENGTH=65536
MODEL_PARALLEL=1

# Physical cores; SMT siblings add no memory bandwidth, and CPU-side expert FFN is what is
# being timed. 🔴 16, not 32 (32 is contention, -4 to -5%). ⚠️ And not 8: 8 wins solo by ~1%
# but LOSES 4.9% at four streams. Tune this at the concurrency you actually serve.
MODEL_THREADS=16

# How many V620s the startup guard insists RADV offers. ⚠️ COUNTED, not checked for non-zero:
# a missing card does not fail a load on its own, llama.cpp would quietly place those layers
# in host RAM. The sweep sets 1 for its ONE_GPU control.
MODEL_EXPECTED_GPUS=2

# Leave EMPTY. ⚠️ Never "none" or "high" — this template RAISES on exactly those two, the
# inverse of Qwen3.8-27B. The server sets --reasoning off, which neutralises it.
# MODEL_REASONING_EFFORT=

# 🔴 REQUIRED alongside MODEL_CPU_MOE, and nothing warns you: --n-cpu-moe makes the first N
# layers light and the rest heavy, while the default split divides evenly BY COUNT and hands
# card 2 every heavy one (measured: 9.3 GiB into GTT, 6.6 t/s).
# Rule: `card1 = CPU_MOE + (48 - CPU_MOE)/2 - 2`; at 16 -> 30,18.
# ⚠️ The `- 2` is load-bearing — without it 15/16/20 still spill. ⚠️ CPU_MOE 48 is exempt and
# stays 48,0. ⚠️ The right split is BATCH-SIZE DEPENDENT (see below).
MODEL_TENSOR_SPLIT=30,18

# 🔴 Pinned LOW deliberately. The launcher defaults to 4096/1024; measured end-to-end:
#   1024/256   min free 2881 / 1878 MiB   no spill      prefill 77.2 t/s
#   4096/1024  min free 2922 /  877 MiB   GTT 306 MiB   prefill 173-236 t/s
# 4096/1024 puts card 2 under the ~1024 MiB RADV floor, so it is not shipped despite being
# 2-3x faster at prefill — the binding constraint. ⚠️ The compute buffer scales with batch and
# lands on the card holding the heavy layers, so batch and --tensor-split are COUPLED: at
# 4096/1024 this placement wants ~`31,17`. Untested. Re-check both cards' free VRAM AND GTT
# before raising this, not throughput.
# ⚠️ Verification gap: the release binary was exercised at 4096/1024 and 1024/256 was measured
# on the baseline tree; this exact pair was not tested together.
MODEL_BATCH_SIZE=1024
MODEL_UBATCH_SIZE=256

# The best-measured two-card shape: 59.3 GiB demand and 14.17/13.45 t/s, against 61.1 GiB and
# 14.16/13.07 for f16 with the projector resident — better on both axes.
# 🔴 q8_0 KV is safe ONLY because the server runs --reasoning off. Hard XOR on this box:
# `reasoning off + q8_0` OR `reasoning low/medium + f16`. Mixing gives silent EMPTY replies,
# so do not relax --reasoning without reverting this to f16.
# ⚠️ --no-mmproj-offload costs 3-5x on IMAGE ENCODING only. If vision latency matters, clear
# both keys and accept 1.6 GiB less headroom.
MODEL_KV_TYPE=q8_0
MODEL_MMPROJ_ON_CPU=true

# auto (default) | none | mmap | mlock. llama.cpp suggests `none` at startup for CPU tensor
# overrides; measured WORSE here (11.18 vs 11.74 t/s, and 31.6 GiB into GTT). Left on auto.
MODEL_LOAD_MODE=

# Appended verbatim to llama-server (word-split). placement-sweep.sh writes --device here
# for its single-GPU control.
EXTRA_ARGS=
