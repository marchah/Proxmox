# CT 123: Strata in place of llama.cpp for Qwen3.8-Flash-Next on one V620 (0000:83:00.0).
# Install: VMID=123 ./install.sh. Installed as /etc/strata-qwen38fn.env; strata-serve-qwen38fn
# writes the server's JSON config from it at every start. Sources of each value: README.md.
# systemd EnvironmentFile comments must occupy their own lines.

# Engine release and commit, and the llama.cpp commit its ggml comes from
# (CMakeLists.txt GIT_TAG). install.sh builds exactly these. The llama.cpp checkout goes
# where setup.py puts it, so the packing tools find its gguf-py without STRATA_GGUF_PY.
STRATA_RELEASE="v0.1.44.1"
STRATA_COMMIT="296b59d2f73c8f04a805df29c2fa97655adace78"
STRATA_GGML_COMMIT="3cf03257f219afbe7334045ff7c6a06ac68c627d"
STRATA_HOME="/opt/strata/strata-v0.1.44.1"
STRATA_GGML_DIR="/opt/strata/strata-v0.1.44.1/third_party/llama.cpp"
STRATA_VENV="/opt/strata/venv"

# ROCm userspace from AMD's apt repository; the kernel driver is the host's in-tree amdgpu.
ROCM_PACKAGE="amdrocm-core-dev10.0-gfx1030"
ROCM_VERSION="10.0.0-4"
ROCM_ROOT="/opt/rocm/core-10.0"

# The UD-Q4_K_XL shards llama.cpp serves. Their SHA-256s match the revision Strata
# supports (38bb39e), so no other download is needed for the model itself.
MODEL_GGUF=/models/hf/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf
# Strata's pack of shard 1 (iq_pack.py --compat-bf16) and the MTP draft layer built from
# the BF16 checkpoint's mtp.* tensors. Both are rebuildable, so they live in the model store.
MODEL_PACK=/models/strata/packs/ud-q4_k_xl
MODEL_MTP_SRC=/models/strata/mtp
MODEL_MTP=/models/strata/mtp/rt

# Same address, port and model name as llama.cpp, so clients and make bench need no change.
MODEL_ALIAS=qwen3.8-flash-next
MODEL_SERVER_BIND=0.0.0.0
MODEL_SERVER_PORT=1234
# Host names besides gpu2 and the container's IPs that the server's Host check accepts.
MODEL_ALLOWED_HOSTS="gpu2.lan"

# One 64k slot, as llama.cpp. strata-qwen38fn-reload rewrites these two.
MODEL_CONTEXT_LENGTH="65536"
MODEL_PARALLEL="1"

# 8-bit KV. From 64k, setup streams the KV cache from RAM and keeps the 32k window the
# attention reads in VRAM. Empty keeps every KV cell in VRAM.
MODEL_KV="int8"
MODEL_KV_RESIDENT="32768"

# Prompt chunks: auto is 8,192 tokens.
MODEL_PREFILL="auto"

# The MTP draft layer drafts up to MODEL_SPEC tokens. Setup's defaults; empty MODEL_SPEC
# runs without the draft layer.
MODEL_SPEC="4"
MODEL_SPEC_MIN_P="0.5"

# CPU expert workers. The engine's default counts the host's physical cores, but CT 123's
# cpuset is 24 CPUs on 21 cores, and STREAM peaks at 16 threads on this box.
MODEL_POOL_WORKERS="15"

# VRAM left free after the expert cache (engine default 700).
MODEL_VRAM_RESERVE_MIB="1024"

# The 28.8 GB n-gram (PLE) table: direct reads from the NVMe store, or ram.
MODEL_PLE_IO="direct"

# Strata cannot see CT 123's memory limit from inside (memory.max reads max); this is
# 120 GiB less 4 GiB.
MODEL_MEMORY_LIMIT_MIB="118784"

# llama.cpp runs with --reasoning off; Strata's default effort is the model's (high).
MODEL_REASONING_EFFORT="none"

# Defaults for requests that send no sampler settings. Strata's own default is greedy;
# these are llama-server's from the GGUF's generation_config (CT 123 /props, 2026-10-16).
MODEL_SAMPLING='{"temperature": 1.0, "top_k": 20, "top_p": 0.95, "min_p": 0.05}'

# More engine arguments, word-split.
MODEL_EXTRA_ARGS=""

# Engine switches for RDNA2 (docs/AMD_HIP.md), exported to the engine. FP16 prompt GEMMs
# (rocBLAS has tuned kernels only for FP16 in/out on gfx1030):
STRATA_HIP_PROMPT_F16="1"
# The shared-expert stream fork, off by default on HIP; +5-13% decode on Linux RX 6900 XT:
STRATA_SH_STREAM="1"
# Adaptive expert swaps copied by a kernel, not SDMA: avoids the gfx1030 verify hang (#884):
STRATA_HIP_ADAPT_KERNEL_COPY="1"
# The engine's READY timeout. The first load reads the 77 GB expert arena from the shards.
STRATA_ENGINE_READY_S="1800"
