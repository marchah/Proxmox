#!/usr/bin/env bash
# Qwen3.8-Flash-Next through Strata on the V620 passed through to CT 123, every routed expert
# in RAM. Installed as /usr/local/bin/strata-serve-qwen38fn in CT 123 by install.sh.
# Writes the server's JSON config from /etc/strata-qwen38fn.env, then runs Strata's server,
# which starts the engine. The STRATA_* switches in the env file reach the engine through
# the environment.
set -Eeuo pipefail
set -a
# shellcheck disable=SC1091  # runtime-only env file
source /etc/strata-qwen38fn.env
set +a

die() { echo "FATAL: $*" >&2; exit 1; }

engine="${STRATA_HOME}/build-hip/strata"
[ -x "${engine}" ] || die "no engine at ${engine}; run install.sh on the host"
[ -c /dev/kfd ] || die "/dev/kfd is not in the container; on the host: ./use-engine.sh strata"
[ -r /dev/kfd ] && [ -w /dev/kfd ] || die "/dev/kfd is not readable and writable by $(id -un) (group render)"
[ -c /dev/dri/renderD128 ] || die "/dev/dri/renderD128 is missing; see pro-v620/README.md 'Recovering after a DRM renumber'"

export LD_LIBRARY_PATH="${ROCM_ROOT}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# One gfx1030 card, or nothing. HIP sees only the render nodes the container holds, so a
# second card here means the passthrough changed; none means the engine cannot start.
devices="$("${STRATA_HOME}/build-hip/strata-device" --list-devices 2>&1 || true)"
found="$(printf '%s\n' "${devices}" | grep -c 'gfx1030' || true)"
if [ "${found}" -ne 1 ]; then
  echo "FATAL: expected one gfx1030 device, strata-device listed ${found}:" >&2
  printf '%s\n' "${devices}" >&2
  exit 1
fi

total="$(printf '%s' "${MODEL_GGUF}" | sed -E 's/.*-00001-of-0*([0-9]+)\.gguf/\1/')"
for i in $(seq 1 "${total}"); do
  shard="$(printf '%s' "${MODEL_GGUF}" | sed -E "s/-00001-of-/-$(printf '%05d' "${i}")-of-/")"
  [ -f "${shard}" ] || die "missing shard $(basename "${shard}")"
done
[ -f "${MODEL_PACK}/native_experts.txt" ] || die "no pack at ${MODEL_PACK}; run install.sh on the host"
[ -f "${MODEL_MTP}/experts.bin" ] || [ -z "${MODEL_SPEC}" ] || die "no MTP draft layer at ${MODEL_MTP}"

config="${RUNTIME_DIRECTORY:-/run/strata-qwen38fn}/config.json"
log_dir="${LOGS_DIRECTORY:-/var/log/strata-qwen38fn}"
ENGINE="${engine}" CONFIG="${config}" LOG="${log_dir}/engine.log" python3 -I - <<'PY'
import json
import os

e = os.environ
args = ["--pack", e["MODEL_PACK"], "--native", e["MODEL_GGUF"],
        "--expert-profile", e["STRATA_HOME"] + "/data/expert-profile.bin", "--expert-cache", "auto",
        "--prefill", e["MODEL_PREFILL"], "--max-context", e["MODEL_CONTEXT_LENGTH"], "--kv", e["MODEL_KV"],
        "--pool-workers", e["MODEL_POOL_WORKERS"], "--vram-reserve-mib", e["MODEL_VRAM_RESERVE_MIB"],
        "--ple-io", e["MODEL_PLE_IO"], "--memory-limit-mib", e["MODEL_MEMORY_LIMIT_MIB"]]
if e.get("MODEL_KV_RESIDENT"):
    args += ["--kv-resident", e["MODEL_KV_RESIDENT"]]
if e.get("MODEL_SPEC"):
    args += ["--spec", e["MODEL_SPEC"], "--spec-min-p", e["MODEL_SPEC_MIN_P"], "--mtp", e["MODEL_MTP"]]
args += e.get("MODEL_EXTRA_ARGS", "").split()
cfg = {
    "exe": e["ENGINE"],
    "args": args,
    "cwd": e["STRATA_HOME"],
    "tokenizer": e["MODEL_PACK"] + "/tokenizer",
    "model_name": e["MODEL_ALIAS"],
    "log": e["LOG"],
    "backend": "hip",
    "gpu": 0,
    "lib_dirs": [e["ROCM_ROOT"] + "/lib"],
    "allowed_hosts": [h for h in e.get("MODEL_ALLOWED_HOSTS", "").split(",") if h],
    "reasoning_effort": e["MODEL_REASONING_EFFORT"],
    "sampling": json.loads(e["MODEL_SAMPLING"]),
}
if int(e["MODEL_PARALLEL"]) > 1:
    cfg["parallel"] = int(e["MODEL_PARALLEL"])
with open(e["CONFIG"], "w", encoding="utf-8") as f:
    json.dump(cfg, f, indent=1)
PY

cd "${STRATA_HOME}"
exec "${STRATA_VENV}/bin/python" -m serve.server --engine strata --config "${config}" \
  --host "${MODEL_SERVER_BIND}" --port "${MODEL_SERVER_PORT}"
