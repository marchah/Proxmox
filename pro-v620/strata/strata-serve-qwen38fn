#!/usr/bin/env bash
# Qwen3.8-Flash-Next through Strata on the V620s passed through to CT 123, every routed expert
# in RAM. Installed as /usr/local/bin/strata-serve-qwen38fn in CT 123 by install.sh.
# Writes the server's JSON config from /etc/strata-qwen38fn.env, then runs Strata's server,
# which starts the engine. The STRATA_* switches in the env file reach the engine through
# the environment.
#
# MODEL_GPUS names the cards by PCI address, resolved to HIP's numbering at every start (HIP
# need not number them in PCI order). One address runs on that card. Two run a layer split
# when MODEL_LAYER_SPLIT is set, the first card first; without it, the second card is the
# first's expert helper, which MODEL_EXTRA_ARGS must ask for (--expert-cache-device1).
set -Eeuo pipefail
set -a
# shellcheck disable=SC1091  # runtime-only env file
source /etc/strata-qwen38fn.env
set +a

die() { echo "FATAL: $*" >&2; exit 1; }

engine="${STRATA_HOME}/build-hip/strata"
[ -x "${engine}" ] || die "no engine at ${engine}; run install.sh on the host"
[ -c /dev/kfd ] || die "/dev/kfd is not in the container; on the host: ./use-engine.sh strata"
[ -r /dev/kfd ] && [ -w /dev/kfd ] || die "/dev/kfd is not readable and writable by $(id -un) (group render)"
# Count with [ -c ]: the nodes are bind mounts over files LXC creates, so find's directory
# entry type reads them as regular files.
renders=0
for node in /dev/dri/renderD*; do [ -c "${node}" ] && renders=$((renders + 1)); done
[ "${renders}" -ge 1 ] || die "no /dev/dri/renderD* node; see pro-v620/README.md 'Recovering after a DRM renumber'"

export LD_LIBRARY_PATH="${ROCM_ROOT}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# HIP must see every card the container holds, as gfx1030. Fewer means a card the DRM cgroup
# rule or the passthrough lost (use-engine.sh sets both); none means the engine cannot start.
devices="$("${STRATA_HOME}/build-hip/strata-device" --list-devices 2>&1 || true)"
found="$(printf '%s\n' "${devices}" | grep -c 'gfx1030' || true)"
if [ "${found}" -ne "${renders}" ]; then
  echo "FATAL: CT holds ${renders} render node(s), strata-device listed ${found} gfx1030 device(s):" >&2
  printf '%s\n' "${devices}" >&2
  exit 1
fi

total="$(printf '%s' "${MODEL_GGUF}" | sed -E 's/.*-00001-of-0*([0-9]+)\.gguf/\1/')"
for i in $(seq 1 "${total}"); do
  shard="$(printf '%s' "${MODEL_GGUF}" | sed -E "s/-00001-of-/-$(printf '%05d' "${i}")-of-/")"
  [ -f "${shard}" ] || die "missing shard $(basename "${shard}")"
done
[ -f "${MODEL_PACK}/native_experts.txt" ] || die "no pack at ${MODEL_PACK}; run install.sh on the host"
[ -f "${MODEL_MTP}/experts.bin" ] || [ -z "${MODEL_SPEC:-}" ] || die "no MTP draft layer at ${MODEL_MTP}"

# Kept after the server stops: quant_quality.py and other one-off engine runs read it.
config="${STATE_DIRECTORY:-/var/lib/strata-qwen38fn}/config.json"
log_dir="${LOGS_DIRECTORY:-/var/log/strata-qwen38fn}"
ENGINE="${engine}" CONFIG="${config}" LOG="${log_dir}/engine.log" python3 -I - <<'PY'
import ctypes
import json
import os
import sys

e = os.environ


def hip_index_of():
    """{PCI address: HIP device index}, from the runtime itself."""
    hip = ctypes.CDLL(e["ROCM_ROOT"] + "/lib/libamdhip64.so")
    n = ctypes.c_int(0)
    if hip.hipGetDeviceCount(ctypes.byref(n)) != 0:
        sys.exit("FATAL: hipGetDeviceCount failed")
    out = {}
    for i in range(n.value):
        buf = ctypes.create_string_buffer(64)
        if hip.hipDeviceGetPCIBusId(buf, 64, i) != 0:
            sys.exit("FATAL: hipDeviceGetPCIBusId failed for device %d" % i)
        out[buf.value.decode().lower()] = i
    return out


index = hip_index_of()
cards = [c.strip().lower() for c in e["MODEL_GPUS"].split(",") if c.strip()]
missing = [c for c in cards if c not in index]
if not cards or missing or len(set(cards)) != len(cards):
    sys.exit("FATAL: MODEL_GPUS %r: HIP has %s" % (e["MODEL_GPUS"], index))
gpus = [index[c] for c in cards]
args = ["--pack", e["MODEL_PACK"], "--native", e["MODEL_GGUF"],
        "--expert-profile", e["STRATA_HOME"] + "/data/expert-profile.bin", "--expert-cache", "auto",
        "--prefill", e["MODEL_PREFILL"], "--max-context", e["MODEL_CONTEXT_LENGTH"], "--kv", e["MODEL_KV"],
        "--pool-workers", e["MODEL_POOL_WORKERS"], "--vram-reserve-mib", e["MODEL_VRAM_RESERVE_MIB"],
        "--ple-io", e["MODEL_PLE_IO"], "--memory-limit-mib", e["MODEL_MEMORY_LIMIT_MIB"]]
if e.get("MODEL_KV_RESIDENT"):
    args += ["--kv-resident", e["MODEL_KV_RESIDENT"]]
if e.get("MODEL_SPEC"):
    args += ["--spec", e["MODEL_SPEC"], "--spec-min-p", e["MODEL_SPEC_MIN_P"], "--mtp", e["MODEL_MTP"]]
args += e.get("MODEL_EXTRA_ARGS", "").split()
cfg = {
    "exe": e["ENGINE"],
    "args": args,
    "cwd": e["STRATA_HOME"],
    "tokenizer": e["MODEL_PACK"] + "/tokenizer",
    "model_name": e["MODEL_ALIAS"],
    "log": e["LOG"],
    "backend": "hip",
    "gpu": gpus[0],
    "lib_dirs": [e["ROCM_ROOT"] + "/lib"],
    "allowed_hosts": [h for h in e.get("MODEL_ALLOWED_HOSTS", "").split(",") if h],
    "reasoning_effort": e["MODEL_REASONING_EFFORT"],
    "sampling": json.loads(e["MODEL_SAMPLING"]),
}
if int(e["MODEL_PARALLEL"]) > 1:
    cfg["parallel"] = int(e["MODEL_PARALLEL"])
if len(gpus) > 1 and e.get("MODEL_LAYER_SPLIT"):
    cfg.update(gpu=gpus, layer_split=e["MODEL_LAYER_SPLIT"], gpu_order="as_given")
elif len(gpus) > 1:
    # The helper mode: the engine sees the primary as device 0 and the helper as device 1.
    if "--expert-cache-device1" not in args:
        sys.exit("FATAL: two cards without MODEL_LAYER_SPLIT need --expert-cache-device1 in MODEL_EXTRA_ARGS")
    cfg["env"] = {"HIP_VISIBLE_DEVICES": ",".join(str(g) for g in gpus)}
print("strata-serve-qwen38fn: cards %s -> HIP %s%s" % (cards, gpus, " (layer split %s)" % e["MODEL_LAYER_SPLIT"]
      if len(gpus) > 1 and e.get("MODEL_LAYER_SPLIT") else " (helper)" if len(gpus) > 1 else ""), file=sys.stderr)
with open(e["CONFIG"], "w", encoding="utf-8") as f:
    json.dump(cfg, f, indent=1)
PY

cd "${STRATA_HOME}"
exec "${STRATA_VENV}/bin/python" -m serve.server --engine strata --config "${config}" \
  --host "${MODEL_SERVER_BIND}" --port "${MODEL_SERVER_PORT}"
