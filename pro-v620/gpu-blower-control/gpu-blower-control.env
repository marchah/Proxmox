# GPU blower control. Same control law as the B550-era pro-v620/fan-control
# (gpu-fan-control-gpu1.env): linear ramp on EDGE temp + hotspot override on the
# hottest of junction/mem. Only the transport differs — BMC fan duty over in-band
# IPMI instead of nct6687 PWM sysfs, which does not exist on this board.
# VERIFIED 2026-09-16 by starving one blower under load: FAN4 cools 0000:83:00.0
# (top card), FAN5 cools 0000:03:00.0 (bottom). This is the REVERSE of PCI bus order --
# do not infer the pairing from bus numbering.
GPU1_PCI=0000:83:00.0
GPU1_FAN=4
GPU2_PCI=0000:03:00.0
GPU2_FAN=5

EDGE_MIN_C=35
EDGE_MAX_C=88
# was 12 on the B550; the BMC enforces Fan_PWM_Min=20 so anything lower is unreachable
PWM_MIN_PCT=20
HOTSPOT_OVERRIDE_C=90
HOTSPOT_RESUME_C=87

OTHER_DUTY=0x14
FAIL_DUTY=100
INTERVAL=4
DUTY_STEP=3
