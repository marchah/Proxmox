# ROMED8-2T: GPU edge-temperature ramp with junction/memory override, via IPMI.
# Physical pairing: FAN4 cools the top card; FAN5 cools the bottom card.
GPU1_PCI=0000:83:00.0
GPU1_FAN=4
GPU2_PCI=0000:03:00.0
GPU2_FAN=5

EDGE_MIN_C=35
EDGE_MAX_C=88
# BMC minimum fan duty is 20%.
PWM_MIN_PCT=20
HOTSPOT_OVERRIDE_C=90
HOTSPOT_RESUME_C=87

OTHER_DUTY=0x14
FAIL_DUTY=100
INTERVAL=4
DUTY_STEP=3
