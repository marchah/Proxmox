# SUPERSEDED 2026-08-22 — kept for reference only, NOT installed (absent from INSTANCES).
# Per-card instances are not usable on this board: only PUMP_FAN1 drives pin 4, and it is
# taken by the hub that feeds BOTH blowers, so there is no second controllable channel.
# The live config is gpu-fan-control-hub.env (one instance, both cards, pwm2). Revisit
# these only if a SYS_FAN header ever becomes PWM-capable (needs BIOS access).
#
# Config for gpu-fan-control@gpu1 (installed to /etc/gpu-fan-control-gpu1.env).
# The PCIe-1 (CPU-slot) V620 — CT 120 `llamacpp` — cooled by its own 9733 blower on
# the PUMP FAN header (nct6687 pwm2/fan2).
#
# ⚠️ Pairing established BY MEASUREMENT 2026-08-22, not from header names: with pwm2
# driven to 0, GPU 1's junction climbed 50C -> 75C in under a minute while GPU 2 held
# 29C. Re-verify the same way after ANY recabling — this pairing has been transposed
# twice from silkscreen labels alone, and a transposed pair makes each card's fan
# answer to the OTHER card's temperature.
#
# systemd EnvironmentFile= does NOT strip trailing inline comments — keep comments
# on their own lines, never after a VAR=value.

FAN_LABEL=gpu1
GPU_PCI_ADDRESS=0000:2d:00.0
# Pump Fan = pwm2/fan2. Verified 2026-08-22 by direct sweep with THIS fan:
#   pwm 255 -> 4301 RPM | 128 -> 3100 | 32 -> 1046 | 0 -> 0 (fan fully stops).
FAN_PWM_CHANNEL=2

# Curve reused verbatim from the retired @blower profile, which was tuned for exactly
# this combination (this card + a 9733 blower + this header) and measured ~83C at
# solo full load with ~93% fan.
EDGE_MIN_C=35
EDGE_MAX_C=88
PWM_MIN_PCT=12
MIN_PWM_RAW=32
HOTSPOT_TEMP_LABELS=junction mem
HOTSPOT_OVERRIDE_C=90
HOTSPOT_RESUME_C=87

FAN_RPM_MONITOR=auto
FAN_MIN_RPM=150
FAN_FAIL_ACTION=warn
