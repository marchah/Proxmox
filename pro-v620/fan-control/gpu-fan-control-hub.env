# Config for gpu-fan-control@hub (installed to /etc/gpu-fan-control-hub.env).
#
# TOPOLOGY (2026-08-22): BOTH 9733 blowers hang off an EN-Labs PWMHUB10SMG. The hub
# takes 12V from SATA (each blower is 12V/18W = 1.5A, far past a SYS_FAN header's
# 1A rating) and takes its PWM control signal from the PUMP FAN header — nct6687
# pwm2. So ONE channel drives BOTH fans, and this curve therefore tracks the HOTTER
# of the two cards, exactly as the retired @shroud instance did.
#
# ⚠️ WHY NOT ONE INSTANCE PER CARD: the SYS_FAN headers are in DC (voltage) mode, so
# their pin 4 carries no PWM signal at all and they cannot control an externally
# powered fan — verified across SYS_FAN1, SYS_FAN2 and SYS_FAN4 with two different
# blowers, a plain cable AND the hub. A 3-pin case fan is smoothly speed-controlled
# on pwm5 (1360→369 RPM, stalling below 18%), which only voltage control can do.
# PUMP_FAN1 is the ONE header on this board proven to drive pin 4. There is no
# software fix for the others: the driver exposes no pwm*_mode attribute, upstream
# documents the PWM-vs-DC unit as "configured by firmware", Nuvoton does not publish
# the NCT6687D register map, and this host has no video output to reach BIOS.
#
# ⚠️ MONITORING GAP: the hub returns a tach signal from its RED port ONLY, so fan2
# reports just one of the two blowers. A failure of the OTHER blower is invisible to
# FAN_RPM_MONITOR. gpu-thermal-watchdog (trip 102C) is the backstop for that card.
#
# systemd EnvironmentFile= does NOT strip trailing inline comments — keep comments
# on their own lines, never after a VAR=value.

FAN_LABEL=hub
# BOTH V620s (comma-separated) — one fan channel cools both, so react to the hottest.
# Treated as a REQUIRED set, re-resolved every poll: if either card goes missing or
# unbound the daemon forces 100% and logs CRITICAL (fail toward cooling).
GPU_PCI_ADDRESS=0000:2d:00.0,0000:06:00.0
# Pump Fan = pwm2/fan2. Verified 2026-08-22 through the hub with both blowers on it:
#   pwm 255 -> 4109 RPM | 128 -> 3225 | 64 -> 1851 | 32 -> 1018 | 0 -> 0 (fully stops)
# Cold-start from a dead stop at pwm=32 reached 982 RPM, so the 12% floor is safe.
FAN_PWM_CHANNEL=2

# Curve is the @blower profile, which is the MEASURED-GOOD one for this exact
# combination: a 9733 blower on a V620, recorded at ~83C junction at solo full load
# with ~93% fan. Each card now has its OWN dedicated 1.5A blower (only the control
# signal is shared through the hub), so capacity is far higher than the single-NF-F12
# shroud whose thermal record produced GPU 2's old 98-102C numbers. An aggressive
# profile (EDGE_MAX 75 / hotspot 85) was tried first and judged over-provisioned for
# a blower of this size — it only bought noise. Hotspot override 90C still leaves 12C
# of margin to the 102C watchdog trip. Re-tune from load-test data, not from theory.
# EDGE_MIN raised 35 -> 45 on 2026-08-22 after the first load test. The fan follows
# EDGE temp, and real workloads here are bursty, living in the 40-55C edge band rather
# than at sustained full load. At EDGE_MIN 35 the fan was already at 1524-2942 RPM
# across that band; at 45 it holds the 1018 RPM floor to 45C and reaches only
# 46% (~3000 RPM) at the 62C edge measured under full dual-card load, versus 56%
# (~3512 RPM) before. Peak cost is small; the mid-band quiet is the point.
EDGE_MIN_C=45
EDGE_MAX_C=88
PWM_MIN_PCT=12
MIN_PWM_RAW=32
HOTSPOT_TEMP_LABELS=junction mem
HOTSPOT_OVERRIDE_C=90
HOTSPOT_RESUME_C=87

FAN_RPM_MONITOR=auto
FAN_MIN_RPM=150
FAN_FAIL_ACTION=warn
