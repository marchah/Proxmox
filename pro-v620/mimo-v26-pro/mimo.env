# CT 123, both cards: the configuration the baseline record starts from. The sweep rewrites
# the settings per cell and restores this file when it ends.
# Install: VMID=123 ./install.sh, after TEST_MODEL=mimo ../glm53-flash/ct123-test-host.sh two-card.
# Installed as /etc/llamacpp-mimo.env. systemd EnvironmentFile comments must occupy their
# own lines.

# Release build with mimo2 (MTP #26228, fused-QKV split #29294, DFlash #29650).
LLAMACPP_DIR="/opt/llamacpp/llama-b11583"

# First shard, metadata only; llama.cpp discovers the other six.
MODEL_PATH=/models/hf/mimo-v2.6-pro-rl/MiMo-V2.6-Pro-RL-MXFP4-00001-of-00007.gguf
MODEL_ALIAS=mimo-v2.6-pro-rl
# Text only: the vision and audio projector is not downloaded.
MODEL_MMPROJ=
MODEL_SERVER_BIND=0.0.0.0
MODEL_SERVER_PORT=1234
MODEL_GPU_LAYERS="99"

# Routed experts of the first N GGUF blocks in host RAM (7,344 MiB per block). 67 puts
# blocks 67-69 on the cards and leaves 473 GiB of experts in RAM; 70 would need 495 GiB.
MODEL_CPU_MOE="67"
MODEL_OT_OVERRIDE=""

# Explicit context; automatic fitting can spill KV to GTT on RADV. Two 32k slots, for the
# two-stream probe.
MODEL_CONTEXT_LENGTH="65536"
MODEL_PARALLEL="2"
MODEL_THREADS="32"

# Startup guard: the number of V620s llama-server must see.
MODEL_EXPECTED_GPUS="2"
MODEL_VK_VISIBLE_DEVICES=""

# Blocks 0-65 on Vulkan0 (GPU 1), blocks 66-69 and the output head on Vulkan1 (GPU 2): the
# sweep's split rule at N_BLOCKS=70.
MODEL_TENSOR_SPLIT="66,4"

# auto (mmap): the RAM experts stay in the page cache. dio would pin them as GTT, which is
# capped at half of RAM (251.8 GiB).
MODEL_LOAD_MODE=""

MODEL_REASONING_BUDGET=""

# 32 threads, one per physical core; needs CT 123 on CPUs 0-47 (TEST_CPUSET=0-47).
EXTRA_ARGS="--cpu-mask 0xffffffff --cpu-strict 1"

MODEL_BATCH_SIZE="4096"
MODEL_UBATCH_SIZE="4096"

# Ten full-attention layers hold per-token KV: 50 KiB per token at f16.
MODEL_KV_TYPE="f16"
MODEL_MMPROJ_ON_CPU="true"
