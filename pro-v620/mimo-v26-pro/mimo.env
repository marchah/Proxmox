# CT 123, both cards: the baseline record's best configuration (runs/2026-10-15-baseline.md),
# MTP at n-max 1. The sweep rewrites the settings per cell and restores this file when it ends.
# Install: VMID=123 ./install.sh, after TEST_MODEL=mimo ../glm53-flash/ct123-test-host.sh two-card.
# Installed as /etc/llamacpp-mimo.env. systemd EnvironmentFile comments must occupy their
# own lines.

# Release build with mimo2 (MTP #26228, fused-QKV split #29294, DFlash #29650).
LLAMACPP_DIR="/opt/llamacpp/llama-b11583"

# First shard, metadata only; llama.cpp discovers the other six.
MODEL_PATH=/models/hf/mimo-v2.6-pro-rl/MiMo-V2.6-Pro-RL-MXFP4-00001-of-00007.gguf
MODEL_ALIAS=mimo-v2.6-pro-rl
# Text only: the vision and audio projector is not downloaded.
MODEL_MMPROJ=
MODEL_SERVER_BIND=0.0.0.0
MODEL_SERVER_PORT=1234
MODEL_GPU_LAYERS="99"

# Routed experts of the first N GGUF blocks in host RAM (7,344 MiB per block). 68 puts
# blocks 68-69 on the cards and leaves 480.5 GiB of experts in RAM; the MTP head takes about
# 4.3 GiB on GPU 2. Without MTP, 67 fits with split 66,4.
MODEL_CPU_MOE="68"
MODEL_OT_OVERRIDE=""

# Explicit context; automatic fitting can spill KV to GTT on RADV. Two 32k slots, for the
# two-stream probe.
MODEL_CONTEXT_LENGTH="65536"
MODEL_PARALLEL="2"
MODEL_THREADS="32"

# Startup guard: the number of V620s llama-server must see.
MODEL_EXPECTED_GPUS="2"
MODEL_VK_VISIBLE_DEVICES=""

# Blocks 0-57 on Vulkan0 (GPU 1), blocks 58-69, the output head and the MTP head on Vulkan1
# (GPU 2), from the record's fit pass 2. GPU 1 also holds the prefill buffers.
MODEL_TENSOR_SPLIT="58,12"

# none, with --no-host --no-repack below: the RAM experts load into anonymous memory. With
# auto (mmap) CT 123's limit cannot hold them in the page cache, and requests read evicted
# experts back from the store. dio would pin them as GTT, capped at half of RAM (251.8 GiB).
MODEL_LOAD_MODE="none"

MODEL_REASONING_BUDGET=""

# 32 threads, one per physical core; needs CT 123 on CPUs 0-47 (TEST_CPUSET=0-47).
# --no-host: no pinned host buffer (GTT). --no-repack: MXFP4 stays in the layout the cards
# read for op offload. MTP: the Q8_0 head at n-max 1; 2 and 3 decode slower, and it drafts
# at most 3.
EXTRA_ARGS="--cpu-mask 0xffffffff --cpu-strict 1 --no-host --no-repack --spec-type draft-mtp -md /models/hf/mimo-v2.6-pro-rl/mtp-MiMo-V2.6-Pro-RL-Q8_0.gguf --spec-draft-n-max 1"

# Micro-batch 4096 overflows GPU 1's prefill buffers.
MODEL_BATCH_SIZE="4096"
MODEL_UBATCH_SIZE="2048"

# Prompts of 1,024 tokens or more prefill on the cards (op offload), shorter ones on the CPU.
GGML_OP_OFFLOAD_MIN_BATCH="1024"

# Ten full-attention layers hold per-token KV: 50 KiB per token at f16.
MODEL_KV_TYPE="f16"
MODEL_MMPROJ_ON_CPU="true"
