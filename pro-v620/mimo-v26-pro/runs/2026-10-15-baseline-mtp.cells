# MiMo-V2.6-Pro-RL baseline, stage 2: MTP screen, one pass. Plan: 2026-10-15-baseline.md.
# run-stage.sh mtp: all classes at d0, two streams. Stage 1's MTP placement (fit pass 2,
# a-mtp-q8-n68) and threshold (1024). n-max 4 runs in the same pass; pick-nmax.py counts it
# only if n-max 3 is the fastest of 1-3.
mtp-n1  MODE=2gpu NCMOE=68 TENSOR_SPLIT=58,12 KV=f16 BATCH=4096 UBATCH=2048 THREADS=32 STREAMS=2 LOAD_MODE=none ENV='GGML_OP_OFFLOAD_MIN_BATCH=1024' EXTRA='--cpu-mask 0xffffffff --cpu-strict 1 --no-host --no-repack --spec-type draft-mtp -md /models/hf/mimo-v2.6-pro-rl/mtp-MiMo-V2.6-Pro-RL-Q8_0.gguf --spec-draft-n-max 1'
mtp-n2  MODE=2gpu NCMOE=68 TENSOR_SPLIT=58,12 KV=f16 BATCH=4096 UBATCH=2048 THREADS=32 STREAMS=2 LOAD_MODE=none ENV='GGML_OP_OFFLOAD_MIN_BATCH=1024' EXTRA='--cpu-mask 0xffffffff --cpu-strict 1 --no-host --no-repack --spec-type draft-mtp -md /models/hf/mimo-v2.6-pro-rl/mtp-MiMo-V2.6-Pro-RL-Q8_0.gguf --spec-draft-n-max 2'
mtp-n3  MODE=2gpu NCMOE=68 TENSOR_SPLIT=58,12 KV=f16 BATCH=4096 UBATCH=2048 THREADS=32 STREAMS=2 LOAD_MODE=none ENV='GGML_OP_OFFLOAD_MIN_BATCH=1024' EXTRA='--cpu-mask 0xffffffff --cpu-strict 1 --no-host --no-repack --spec-type draft-mtp -md /models/hf/mimo-v2.6-pro-rl/mtp-MiMo-V2.6-Pro-RL-Q8_0.gguf --spec-draft-n-max 3'
mtp-n4  MODE=2gpu NCMOE=68 TENSOR_SPLIT=58,12 KV=f16 BATCH=4096 UBATCH=2048 THREADS=32 STREAMS=2 LOAD_MODE=none ENV='GGML_OP_OFFLOAD_MIN_BATCH=1024' EXTRA='--cpu-mask 0xffffffff --cpu-strict 1 --no-host --no-repack --spec-type draft-mtp -md /models/hf/mimo-v2.6-pro-rl/mtp-MiMo-V2.6-Pro-RL-Q8_0.gguf --spec-draft-n-max 4'
