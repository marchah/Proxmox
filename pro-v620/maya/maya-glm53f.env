# CT 123: Project Maya in place of llama.cpp for GLM-5.3-Flash, on GPU 2 (0000:83:00.0) or
# both cards. Install: VMID=123 ./install.sh. Installed as /etc/maya-glm53f.env;
# maya-serve-glm53f writes the server's JSON config from it at every start. Sources of each
# value: README.md. systemd EnvironmentFile comments must occupy their own lines.

# Engine release and commit, and the llama.cpp commit its ggml and gguf-py come from
# (setup.py LLAMA_CPP_COMMIT). The llama.cpp checkout goes where Maya's setup puts it.
MAYA_RELEASE="v1.1.15"
MAYA_COMMIT="a4e1ff087a4097a73713336df5912d03a1453c46"
MAYA_GGML_COMMIT="3cf03257f219afbe7334045ff7c6a06ac68c627d"
MAYA_HOME="/opt/maya/maya-v1.1.15"
MAYA_GGML_DIR="/opt/maya/maya-v1.1.15/third_party/llama.cpp"
MAYA_VENV="/opt/maya/venv"

# The ROCm userspace ../strata/install.sh installed; the kernel driver is the host's amdgpu.
ROCM_PACKAGE="amdrocm-core-dev10.0-gfx1030"
ROCM_VERSION="10.0.0-4"
ROCM_ROOT="/opt/rocm/core-10.0"

# The quality gate's reference: llama.cpp built for the CPU at the release the control runs.
GATE_LLAMACPP_TAG="b11583"
GATE_LLAMACPP_DIR="/opt/maya/llama.cpp-b11583"

# The pack Maya serves. The engine reads the GGUF shards from the pack's parent folder:
# /models/maya/ud-q4_k_xl holds symlinks to llama.cpp's UD-Q4_K_XL shards; /models/maya/Maya-L
# holds Maya-L's own.
MODEL_PACK=/models/maya/ud-q4_k_xl/pack

# Same address, port and model name as llama.cpp, so the probes and clients need no change.
MODEL_ALIAS=glm-5.3-flash
MODEL_SERVER_BIND=0.0.0.0
MODEL_SERVER_PORT=1234

# The cards, by PCI address, in the order the engine gets them: GPU 2 alone. Two addresses
# run a layer split, the first card first, at MODEL_LAYER_SPLIT: the first layer of the
# second card, or auto for the engine's search. On the V620 the search reads 64 GB/s from
# HIP's memory clock (the card gives 512) and gives the first card only the dense layers,
# with no expert pool and no prompt path; 24 gives each card 21 MoE layers.
MODEL_GPUS="0000:83:00.0"
MODEL_LAYER_SPLIT="auto"

# One 64k context, as llama.cpp's one 64k slot.
MODEL_CONTEXT_LENGTH="65536"
MODEL_PARALLEL="1"

# Setup's arguments: prompt chunks sized by the engine, KV streamed from RAM, the shipped
# expert profile, the expert pool sized to the free VRAM less the reserve below.
MODEL_PREFILL="auto"
MODEL_KV_STREAMING="on"
MODEL_EXPERT_CACHE="auto"

# llama.cpp runs with --reasoning-budget 0; Maya's default effort is high.
MODEL_REASONING_EFFORT="none"

# Defaults for requests that send no sampler settings: Maya's, the model's generation_config.
MODEL_SAMPLING='{"temperature": 1.0, "top_p": 0.95}'

# More engine arguments, word-split.
MODEL_EXTRA_ARGS=""

# Setup's engine settings for a discrete HIP card of 20 GB or more (maya.py write_config):
# 3 GiB of VRAM and 16 GiB of RAM left free, 1024-token prompt sub-batches and a 4 GiB
# prompt budget borrowed from the expert pool. There is no hipBLASLt table for gfx1030.
STRATA_GLM_RESERVE_MB="3072"
STRATA_GLM_RAM_HEADROOM_GB="16"
STRATA_GLM_PREFILL_SUB="1024"
STRATA_GLM_PREFILL_MB="4096"
# The RAM tier holds every expert the VRAM does not, so nothing is read from the SSD while it
# answers; the start fails if it cannot.
STRATA_GLM_RAM_RESIDENT="1"
# No prompt reuse: no snapshot of the last prompt, no conversation set aside on the SSD and no
# checkpoint, so every request reads its whole prompt, as the probes' cold rows need. Without it a
# repeated prompt read 1 of its 24 tokens with slots and checkpoints off.
STRATA_GLM_NO_REUSE="1"
