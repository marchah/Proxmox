# Add these to /root/.hermes/.env on CT 121 (comments on their own lines).
# SLACK_BOT_TOKEN and SLACK_ALLOWED_USERS are already there for the Slack gateway; the plugin
# reuses them, and only captures messages from SLACK_ALLOWED_USERS.

# The board's base URL as CT 121 reaches it.
PROJECT_PLANNER_URL=http://docker-host.lan:4200

# The private #ideas channel's ID (Slack: channel name → About → bottom). Not committed.
PROJECT_PLANNER_SLACK_CHANNEL=
