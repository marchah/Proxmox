# Config for token-usage-collect.service (CT 121). Installed to /etc/token-usage.env.
# The installer keeps an existing file, so local edits survive a re-run.

# Sources to scrape, space-separated `name=url`. The name is the label that shows
# up in the ledger and in token-usage-report output.
#
# CT 120 only; CT 123 also exposes :1234/metrics but is not collected here.
TOKEN_USAGE_SOURCES="llamacpp=http://llamacpp:1234/metrics"

# Durable ledger, readable by Hermes. Excluded from the git config backup;
# backed up by the weekly CT 121 vzdump.
TOKEN_USAGE_DIR=/root/.hermes/token-usage

# Day-bucket boundary. Matches the homelab's timezone so a "day" here means the
# same thing it does in Hermes cron schedules and the pricing reports.
TOKEN_USAGE_TZ=America/New_York

# Per-scrape HTTP timeout, seconds. Short on purpose: a busy llama-server still
# answers /metrics promptly, and a hung scrape just means one missed sample.
TOKEN_USAGE_TIMEOUT=5

# Provider accounting from Hermes; this includes calls that never reach CT 120.
TOKEN_USAGE_DB=/root/.hermes/state.db

# Space-separated providers. Exclude custom/auto/empty to avoid counting CT 120 twice.
TOKEN_USAGE_DB_PROVIDERS="openai-codex"
