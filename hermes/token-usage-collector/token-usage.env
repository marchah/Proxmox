# Config for token-usage-collect.service (CT 121). Installed to /etc/token-usage.env.
# The installer keeps an existing file, so local edits survive a re-run.

# Sources to scrape, space-separated `name=url`. The name is the label that shows
# up in the ledger and in token-usage-report output.
#
# Only llama.cpp's own /metrics works here. CT 123 (gpu2) is deliberately absent:
# llama-swap's :8080/metrics answers 200 but serves host gauges (CPU, memory,
# swap, load, network) and no token counters at all. Adding --metrics to each
# model in llama-swap's config would expose per-model llama.cpp counters at
# /upstream/<model>/metrics, but llama-swap unloads and reloads models on demand,
# so those reset on every swap and are unreachable while a model is unloaded —
# strictly worse than not measuring. See README.md.
TOKEN_USAGE_SOURCES="llamacpp=http://llamacpp:1234/metrics"

# Where the ledger lives. Under /root/.hermes so backup-automations.sh picks it up
# (that script rsyncs ~/.hermes and this path is not deny-listed), and so the
# weekly pricing job can read it without extra plumbing.
TOKEN_USAGE_DIR=/root/.hermes/token-usage

# Day-bucket boundary. Matches the homelab's timezone so a "day" here means the
# same thing it does in Hermes cron schedules and the pricing reports.
TOKEN_USAGE_TZ=America/New_York

# Per-scrape HTTP timeout, seconds. Short on purpose: a busy llama-server still
# answers /metrics promptly, and a hung scrape just means one missed sample.
TOKEN_USAGE_TIMEOUT=5

# ── Cloud/provider usage, read from Hermes' own accounting ────────────────────
# Hermes records every model call in state.db's `session_model_usage` table with
# its billing_provider, so this is the only place usage for a cloud model shows up
# — a model reached over `openai-codex` (e.g. gpt-5.6-terra, which the weekly
# pricing cron now runs on) never touches CT 120 and so is invisible to /metrics.
TOKEN_USAGE_DB=/root/.hermes/state.db

# Which billing_providers to collect from that table, space-separated.
#
# ⚠️ DO NOT add `custom`, `auto`, or the empty provider. Those are CT 120 traffic,
# which the llamacpp /metrics source above ALREADY counts — adding them here would
# double-count every local token. The two sources deliberately measure different
# populations and must not be summed:
#   llamacpp (endpoint) = everything hitting CT 120, including non-Hermes clients
#                         such as OpenCode on the Mac; no attribution; resets on
#                         llama-server restart.
#   <provider>/<model>  = what Hermes itself spent, attributed per model, exact
#     (this table)         per-row deltas, unaffected by restarts.
# `token-usage-report` keeps them in separate families for the same reason.
TOKEN_USAGE_DB_PROVIDERS="openai-codex"
