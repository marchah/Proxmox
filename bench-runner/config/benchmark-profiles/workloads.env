# Agent sessions and document ingestion only (BENCHMARKS.md, "Agent sessions and document
# ingestion"). The coding preset needs 128k slots: CT 120 at 262144 with --parallel 2.
# local-model.env turns llama-benchy on before this file is read, so the caller passes
# RUN_LLAMA_BENCHY=false (llm-bench-workloads does).
: "${RUN_OPENAI_DIRECT:=false}"
: "${RUN_AGENT_SESSIONS:=true}"
: "${RUN_DOC_INGEST:=true}"
: "${BENCHMARK_AGENT_PRESETS:=hermes coding}"
: "${BENCHMARK_INGEST_DEPTHS:=8192 16384 32768 49152}"
: "${BENCHMARK_RUNS:=3}"
: "${TELEMETRY_INTERVAL:=1}"
: "${BENCHMARK_SLO_FILE:=config/benchmark-slos/default.json}"
